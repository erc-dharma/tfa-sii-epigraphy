                <ab>
                    <lb n="1"/>svasti śrī
                </ab>
                
                <lg n="1">
                    <l n="ab">śrīmat-soma-kulāṁbhojaraviṇā dīpta-<unclear>t</unclear>ejasā</l>
                    <l n="cd">rāja-lakṣmī-kucā<unclear>lakta</unclear>-kalaṁkīkṛta-vakṣasā</l>
                </lg>
                
                <lg n="2">
                    <l n="ab">Uddāma-bāhu-vīryyeṇa rakṣitā kṣiti-maṇḍal<unclear>ā</unclear></l>
                    <l n="cd">niskalaṁka-yaśaś-candra-candrikā-vilasaddiśā</l>
                </lg>
                
                <lg n="3">
                    <l n="ab">surāpānakṛto d<unclear>o<!--kompu clear--></unclear>so yena rājñā nirākṛtaḥ</l>
                    <l n="cd">dvijānām agrahāre
                        <lb n="2" break="no"/>bhyaś cārucāritra<choice><sic>ṣ</sic><corr>ś</corr></choice>āḷinā</l>
                </lg>
                
                <lg n="4">
                    <l n="ab">dattā bhūpa<choice><sic>nn</sic><corr>ṁ n</corr></choice>irākṛtya balād viśvāsakhātinaM</l>
                    <l n="cd">rājyaṁ sva-bhuja-vīryyeṇa gṛhītaṁ yena māninā</l>
                </lg>
                
                <lg n="5">
                    <l n="ab">so ’yaṁ ka<supplied reason="omitted">r</supplied>ṇṇa-samas tyāge <unclear>pārttha</unclear>-kalpaḥ parākrame</l>
                    <l n="cd">surendra-sadṛśo lakṣmyā bṛhaspati-samo dhiyā</l>
                </lg>
                
                <lg n="6">
                    <l n="ab">śrī-kundavarmar guṇav<choice><sic>a</sic><corr>ā</corr></choice>n <unclear>ā</unclear>lupe<unclear>ndro<!--kompu clear--></unclear> mahīpatiḥ</l>
                    <l n="cd"><lb n="3"/>pād<unclear>ā</unclear>ravinda-bhramaro bāla-candra-śikhāmaṇeḥ</l>
                </lg>
                
                <lg n="7">
                    <l n="ab">kalau va<supplied reason="omitted">r</supplied>ṣa-sahasrāṇām atikrānte catuṣ<choice><sic>ṭh</sic><corr>ṭ</corr></choice>aye</l>
                    <l n="cd">pu<unclear>nar abda</unclear>-śate caivāṣṭaṣaṣṭyā samanvite</l>
                </lg>
                
                <lg n="8">
                    <l n="ab">gateṣu nava-māseṣu kanyāyāṁ saṁsthite gurau</l>
                    <l n="cd">paścime ’hani rohiṇyām muhū<unclear>r</unclear>tte śubha-lakṣaṇe</l>
                </lg>
                
                <lg n="9">
                    <l n="ab"><lb n="4"/>lokeśvarasya devasya pratiṣṭhām akaro<unclear>t pra</unclear>bhuḥ</l>
                    <l n="cd">śrīmat-kadi<unclear>ri</unclear>kā-nāmni vihāre su-manohare 
                        <g ref="sym:bullet-double-hollow" type="symbol">*</g><g ref="sym:bullet-middle-hollow" type="symbol">*</g>
                    </l>
                </lg>
                
                <p>
                    svasti śrī <g ref="sym:bullet-middle-hollow" type="punctuation">.</g><g ref="sym:bullet-middle-hollow" type="punctuation">.</g><g ref="sym:bar" type="punctuation">.</g>
                </p>
                
