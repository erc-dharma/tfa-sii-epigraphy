            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <p>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </p>
                
                <p>
                    <hi rend="grantha">tribhu</hi>vana-c-ca<hi rend="grantha">kra</hi>va<unclear>t=ti</unclear>kaḷ maturaiyum pāṇṭiyaṉ muṭi-t-talaiyuṅ koṇṭ-aruḷi v<choice><orig>i</orig><reg>ī</reg></choice>rar Api<hi rend="grantha">ṣe</hi>kamum vicaiyar Api<hi rend="grantha">ṣe</hi>kamum paṇṇi-y-aruḷiya <hi rend="grantha">tribhu</hi>vana-v<choice><orig>i</orig><reg>ī</reg></choice>ra<hi rend="grantha">de</hi>vaṟku yāṇṭu <num value="32">3 <g type="numeral">10</g> 2</num> vatu<!--ASI transcript: ṭāvatu-->
                </p>
                
                <p>                    
                    <hi rend="grantha">ja</hi>yaṅ-ko 
                    <lb n="2" break="no"/>ṇṭa-cōḻa-maṇṭalattu kuṉṟavattana-k-kōṭṭattu pāratan taṉṉai Arun-tamu<!-- i.e. mi; ASI transcript unclear-->ḻ paṭutti-c civaṉeṟi kaṇṭa <unclear>A</unclear>ṟanilai-vicākaṉ <hi rend="grantha">trailokya</hi>-mallaṉ va<hi rend="grantha">tsa</hi>-rā<!--ASI transcript: Grantha ra--><hi rend="grantha">ja</hi>ṉ Im-maṇṭalattu maṇaviṟ-kōṭṭattu-t tiru-p-paḻaiya
                    <lb n="3" break="no"/>ṉūr-nāṭṭu Uṭaiyār tiru-v-ālaṅkāṭu Uṭaiya ṉāyaṉār tiru-v-araṅkil Aṇṭamuṟanimirnt-aruḷi<choice><orig>n</orig><reg>ṉ</reg></choice>a ṉā<!--compare ASI transcript-->yaṉārkku vaitta tiru-nantā-viḷakku Oṉṟukku maṉṟāṭi cūṟṟiyap<unclear>pa</unclear>ṉ viḷakku Araiyum Uyyavantāṉ
                    <lb n="4"/>caṭṭa<!--ASI transcript: caṭṭi-->kkoṉ viḷakku Araiyum Āka viḷakku O<choice><orig>n</orig><reg>ṉ</reg></choice>ṟukku-p pacu mu-p-patt’ iraṇ<supplied reason="omitted">ṭu</supplied>kkum <hi rend="grantha">ṛṣabha</hi>m Oṉṟukkum nāṅkaḷ kai-k-koṇṭa paḻaṅ kācu nāṟ-patu
                </p>
                
                <p>                    
                    Ip-paḻaṅ kācu ṉāṟ-patuṅ kai-k-koṇṭu ṉāḷ Oṉṟukku Aru-mo
                    <lb n="5" break="no"/>ḻi-tēvaṉāl Uḻakku ney cantirātitta-varai-y celutta-k kaṭavōm āka kuṉṟavattaṉa-k-kōṭṭattu Illattūr-nāṭṭu Arumpākkattu pārataṉ tannai y-arun tamiḻ-p paṭutti-c civa
                    <lb n="6" break="no"/>-neṟi kaṇṭa Aṟanilai-vicākaṉ <hi rend="grantha">trai</hi>lo<unclear>kkiya</unclear>-mal<unclear>laṉ va</unclear><hi rend="grantha"><unclear>tsa</unclear></hi>-<unclear>rā</unclear><hi rend="grantha"><unclear>ja</unclear></hi><unclear>ṉ</unclear> <gap reason="lost" quantity="5" unit="character"/> kai-k-koṇṭōm Ivv-iruvōm
                </p>
                
