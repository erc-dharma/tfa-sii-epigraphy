            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <p>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </p>
                
                <p>
                    Em-maṇṭalamuṅ koṇṭ-aruḷiya <hi rend="grantha">śrī</hi>-kulacēkara-<hi rend="grantha">de</hi>va<supplied reason="omitted">r</supplied>kku yāṇṭu patiṉ ēḻ-āvatu
                </p>
                
                <p>                    
                    <lb n="2"/><hi rend="grantha">tribhu</hi>vaṉa-<hi rend="grantha">ca</hi>k<hi rend="grantha">ra</hi>vat=ti koneriṉmaikoṇṭāṉ maṇalūr vakuḷāparaṇapaṭṭaṟku tiruva
                    <lb n="3" break="no"/>ḻuti-vaḷanāṭṭu tiru-k-kōyil poliñcuniṉṟ-aruḷiya parama<hi rend="grantha">svā</hi>mikaḷukkum Āḻvār tirunāṭ-u⌈
                    <lb n="4" break="no"/>ṭaiya pirāṉukkum tarma-<hi rend="grantha">I</hi>ti<hi rend="grantha">hāsa-purā</hi>ṇaṅkaḷum vācittu ciṟappukkaḷukkum vācittu cu
                    <lb n="5" break="no"/><hi rend="grantha">ś</hi>lokaṅkaḷuñ colli Itukku muṉpu peṟṟu-p potum paṭiyile nāḷ oṉṟu
                    <lb n="6" break="no"/>kku muṉṟu <hi rend="grantha">prasāda</hi>mum Iraṇṭu Appamum Oru Akkāraiyum nālu tiru-t-tampalamum
                    <lb n="7"/>Oru piṭikaḷaka <hi rend="grantha">prasāda</hi>mum to<supplied reason="omitted">ra</supplied>ṇamālaiyum māta U<hi rend="grantha">Tsa</hi>vaṅkaḷilum tiru-nāḷ ka<choice><orig>ḷḷ</orig><reg>ḷ</reg></choice>ilum tiru-v-a
                    <lb n="8" break="no"/>ttiyyaṉaṅkaḷilum ciṟapp-āka-p peṟṟu potum peṟupeṟukaḷun tāmun tamm-uṭaiya va<unclear>ṟ</unclear>
                    <lb n="9" break="no"/>kattārum vācittu-p peṟṟu-p-potavum Ip-paṭi cantirātittava<hi rend="grantha">T</hi> celvat-āka kallilum cem
                    <lb n="10" break="no"/>pilum veṭṭi-k-koḷḷavum pāṟka
                </p>
                
                <p>
                    Ivai Āṉāntūr-uṭaiyāṉ Eḻuttu yāṇṭu patiṉ ēḻ-ā
                    <lb n="11" break="no"/>vatu nāḷ <num value="346">3 <g type="numeral">100</g> 4 <g type="numeral">10</g> 6</num>
                </p>
                <p>
                    Ivai yātavarāyaṉ Eḻuttu 1
                </p>
                <p>
                    Ivai paḻantivarāyaṉ Eḻuttu
                </p>
                
                <p xml:lang="san-Latn" rendition="class:grantha maturity:vernacular">
                    <lb n="12"/>svasty astu 
                </p>
                
