        <body>
            
            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:vernacular">
                
                <p>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </p>
                
                <p>
                    <hi rend="grantha">tribhu</hi>vana-<hi rend="grantha">c-cakra</hi>va<hi rend="grantha"/>
                    <lb n="2" break="no"/>t=ti kōṉēri<choice><orig>m</orig><reg>ṉ</reg></choice>maikoṇṭāṉ
                    <lb n="3"/>karaivaḻināṭṭu-t
                    <lb n="4"/>tiru-v-ālanturai
                    <lb n="5" break="no"/>-y-āṉa vik<hi rend="grantha"><unclear>ra</unclear></hi>ma-cōḻa
                    <lb n="6" break="no"/>-<hi rend="grantha">c-ca</hi>tu<hi rend="grantha">rvve</hi>ti-maṅkalat
                    <lb n="7" break="no"/>tu <hi rend="grantha">sabh</hi>aiyārkku-t taṅ
                    <lb n="8" break="no"/>kaḷūr-t tuṟaiyil ma<hi rend="grantha">hā</hi>
                    <lb n="9" break="no"/>-<hi rend="grantha">bhā</hi>ratam vācikkum pēṟku
                    <lb n="10"/>Ivv-ūril irupatt’ eṭṭ-āvatu
                    <lb n="11"/>varaiyuṅ kāṭu pāḻāṉa nilattil
                    <lb n="12"/>tillai-nāyakaṉ tirutti-k kuṭukkum nila
                    <lb n="13" break="no"/>m Arai māvum
                </p>
                
                <p>                    
                    In-nilattukku varuṅka
                    <lb n="14" break="no"/>ṭamai nellu Ōṭṭaccu Ārāṭci Anta
                    <lb n="15" break="no"/>rāyam Ēlvai Ukavai kāṇikkai maṇ
                    <lb n="16" break="no"/>ṭala mutalmai-p peṟu mutal Eḻuttu 
                    <lb n="17"/>viṉiyōkam kāliṅkarāyar viṉi
                    <lb n="18" break="no"/>yōkam cantu-vi<hi rend="grantha">graha</hi>-p peṟu ko
                    <lb n="19" break="no"/>ṇṭatu mutal kuṟṟateṇṭam kāt
                    <lb n="20" break="no"/>tikai-p-paccai maṟṟum Eppēṟpaṭṭa I
                    <lb n="21" break="no"/>ṟaikaḷum Iru-patt’ oṉpatāvatu mu
                    <lb n="22" break="no"/>tal Iṟai-y-ili-y-āka-t tantōm
                </p>
                
                <p>
                    Ip
                    <lb n="23" break="no"/>-paṭikku Ivv-ōlai piṭipāṭ-āka-k
                    <lb n="24"/>koṇṭu ca<hi rend="grantha">ndrā</hi>tittava<hi rend="grantha">T</hi> celvat-ā
                    <lb n="25" break="no"/>ka-k kallilum cempilum veṭṭi
                    <lb n="26" break="no"/>-k-koḷka
                </p>
                <p>
                    Ivai villavataraiyaṉ
                    <lb n="27"/>Eḻuttu yāṇṭu <num value="29">2 <g type="numeral">10</g> 9</num> nāḷ <num value="98">9 <g type="numeral">10</g> 8</num></p>
                <p>
                    Ivai
                </p>
                
            </div>
            
            <div type="apparatus">
